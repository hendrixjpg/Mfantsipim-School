{
  "entities": {
    "NewsItem": {
      "title": "News Item",
      "description": "A news article or school update",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Headline of the news" },
        "content": { "type": "string", "description": "Full content of the article" },
        "date": { "type": "string", "format": "date-time", "description": "Publication date" },
        "imageUrl": { "type": "string", "description": "URL of the cover image" },
        "category": { "type": "string", "enum": ["Academic", "Sports", "Alumni", "General", "Innovation"] },
        "author": { "type": "string", "description": "Name of the author" },
        "authorUid": { "type": "string", "description": "UID of the admin who posted" }
      },
      "required": ["title", "content", "date", "category", "author", "authorUid"]
    },
    "Achievement": {
      "title": "Achievement",
      "description": "A school award or milestone",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "year": { "type": "string" },
        "category": { "type": "string", "enum": ["Academic", "Sports", "Arts", "Innovation"] }
      },
      "required": ["title", "description", "year", "category"]
    },
    "LeaderboardEntry": {
      "title": "Leaderboard Entry",
      "description": "House points for the leaderboard",
      "type": "object",
      "properties": {
        "houseName": { "type": "string" },
        "points": { "type": "integer" },
        "rank": { "type": "integer" }
      },
      "required": ["houseName", "points"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "Information about a registered user",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "alumni", "student", "guest"] },
        "graduationYear": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    },
    "MediaGallerySubmission": {
      "title": "Media Gallery Submission",
      "description": "A suggested video link from TikTok for the gallery",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Title of the video highlight" },
        "description": { "type": "string", "description": "Description of the highlight" },
        "date": { "type": "string", "format": "date", "description": "Submission date" },
        "category": { "type": "string", "enum": ["NSMQ", "Cadet/Speech Day", "Sports/Chants", "Choir/Hymns", "Campus Life"] },
        "tiktokUrl": { "type": "string", "description": "TikTok share URL" },
        "thumbnailUrl": { "type": "string", "description": "Cover background thumbnail URL" },
        "likes": { "type": "integer" },
        "comments": { "type": "integer" },
        "author": { "type": "string", "description": "Submitter credit name" }
      },
      "required": ["title", "category", "tiktokUrl", "thumbnailUrl", "likes", "comments", "author"]
    },
    "NewsletterSubscriber": {
      "title": "Newsletter Subscriber",
      "description": "Information about a user subscribed to the newsletter",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email", "description": "Subscriber's email address" },
        "subscribedAt": { "type": "string", "format": "date-time", "description": "ISO timestamp of when they subscribed" },
        "source": { "type": "string", "description": "Webpage source of subscription" },
        "active": { "type": "boolean", "description": "Subscription status" }
      },
      "required": ["email", "subscribedAt"]
    }
  },
  "firestore": {
    "/news": {
      "schema": { "$ref": "NewsItem" },
      "description": "Collection of school news articles"
    },
    "/achievements": {
      "schema": { "$ref": "Achievement" },
      "description": "Collection of school achievements"
    },
    "/leaderboard": {
      "schema": { "$ref": "LeaderboardEntry" },
      "description": "Collection of house points"
    },
    "/users": {
      "schema": { "$ref": "UserProfile" },
      "description": "Collection of user profiles"
    },
    "/media_gallery_submissions": {
      "schema": { "$ref": "MediaGallerySubmission" },
      "description": "Collection of visitor-submitted media gallery items from TikTok"
    },
    "/newsletter_subscribers": {
      "schema": { "$ref": "NewsletterSubscriber" },
      "description": "Collection of newsletter subscriber emails"
    }
  }
}
